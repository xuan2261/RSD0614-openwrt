+static int wext_parse_rtl_mib_auth_file(FILE *f, struct iwinfo_crypto_entry *c)
+{
+	char line[256];
+	int privacy = -1, psk = 0, wpa_c = 0, wpa2_c = 0, dot1x = 0, auth_alg = 0;
+
+	memset(c, 0, sizeof(*c));
+
+	while (fgets(line, sizeof(line), f))
+	{
+		char *p = line;
+		int val = 0;
+
+		while (*p == ' ' || *p == '\t')
+			p++;
+
+		if (!strncmp(p, "dot11PrivacyAlgrthm:", 20) && sscanf(p + 20, "%d", &val) == 1)
+			privacy = val;
+		else if (!strncmp(p, "dot11AuthAlgrthm:", 17) && sscanf(p + 17, "%d", &val) == 1)
+			auth_alg = val;
+		else if (!strncmp(p, "dot11EnablePSK:", 15) && sscanf(p + 15, "%d", &val) == 1)
+			psk = val;
+		else if (!strncmp(p, "dot11WPACipher:", 15) && sscanf(p + 15, "%d", &val) == 1)
+			wpa_c = val;
+		else if (!strncmp(p, "dot11WPA2Cipher:", 16) && sscanf(p + 16, "%d", &val) == 1)
+			wpa2_c = val;
+		else if (!strncmp(p, "dot118021xAlgrthm:", 18) && sscanf(p + 18, "%d", &val) == 1)
+			dot1x = val;
+	}
+
+	if (privacy < 0)
+		return -1;
+
+	if (privacy == 0 && psk == 0)
+	{
+		c->enabled = 0;
+		return 0;
+	}
+
+	c->enabled = 1;
+	if (psk & 3)
+	{
+		int cmask = 0;
+		c->wpa_version = (uint8_t)(psk & 3);
+		c->auth_suites = dot1x ? IWINFO_KMGMT_8021x : IWINFO_KMGMT_PSK;
+		if (psk & 1)
+			cmask |= wpa_c;
+		if (psk & 2)
+			cmask |= wpa2_c;
+		if (cmask & 2)
+		{
+			c->pair_ciphers |= IWINFO_CIPHER_TKIP;
+			c->group_ciphers |= IWINFO_CIPHER_TKIP;
+		}
+		if (cmask & 8)
+		{
+			c->pair_ciphers |= IWINFO_CIPHER_CCMP;
+			c->group_ciphers |= IWINFO_CIPHER_CCMP;
+		}
+		if (!c->pair_ciphers)
+		{
+			if (privacy == 2)
+				c->pair_ciphers = c->group_ciphers = IWINFO_CIPHER_TKIP;
+			else
+				c->pair_ciphers = c->group_ciphers = IWINFO_CIPHER_CCMP;
+		}
+	}
+	else if (privacy == 1 || privacy == 5)
+	{
+		c->pair_ciphers = c->group_ciphers = (privacy == 5) ? IWINFO_CIPHER_WEP104 : IWINFO_CIPHER_WEP40;
+		c->auth_algs = (auth_alg == 1) ? IWINFO_AUTH_SHARED : IWINFO_AUTH_OPEN;
+	}
+
+	return 0;
+}
