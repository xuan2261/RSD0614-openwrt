+static int rtl8197f_dl_read(struct uart_8250_port *up)
+{
+	struct uart_port *p = &up->port;
+	unsigned int dll, dlm;
+
+	dll = readl(p->membase + (UART_DLL << p->regshift)) & 0xff;
+	dlm = readl(p->membase + (UART_DLM << p->regshift)) & 0xff;
+
+	return dll | (dlm << 8);
+}
+
+static void rtl8197f_dl_write(struct uart_8250_port *up, int value)
+{
+	struct uart_port *p = &up->port;
+
+	writel(value & 0xff,
+	       p->membase + (UART_DLL << p->regshift));
+	writel((value >> 8) & 0xff,
+	       p->membase + (UART_DLM << p->regshift));
+}
