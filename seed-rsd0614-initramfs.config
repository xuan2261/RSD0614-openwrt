CONFIG_TARGET_realtek=y
CONFIG_TARGET_realtek_rtl8197f=y
CONFIG_TARGET_realtek_rtl8197f_DEVICE_RSD0614=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_KERNEL_CRASHLOG is not set
# Incompatible donor DIR-842 Wi-Fi stack stays disabled
# CONFIG_PACKAGE_kmod-rtw88 is not set
# CONFIG_PACKAGE_rtl8822be-firmware is not set
# CONFIG_PACKAGE_kmod-rtl8192cd is not set
# CONFIG_PACKAGE_wpad-basic is not set
# CONFIG_PACKAGE_wpad-mini is not set
# CONFIG_PACKAGE_hostapd is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_hostapd-mini is not set
# CONFIG_PACKAGE_iw is not set
# M3 RSD0614 dual-band Wi-Fi (RTL8197G 2.4G + RTL8814BR 5G, WEXT + in-kernel WPA2-PSK)
CONFIG_PACKAGE_kmod-rtl8192cd-rsd0614=y
CONFIG_PACKAGE_wireless-tools=y
# M3 diagnostics & benchmarking
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
# CONFIG_PACKAGE_tcpdump-mini is not set
# M3 LuCI 19.07 web GUI (pinned EOL Lua-era feeds)
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_cgi-io=y
# Target & toolchain bounds
# CONFIG_TARGET_ALL is not set
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TOOLCHAINOPTS=y
# CONFIG_GDB is not set
