+static u32 rtl8197f_read_soc_id(void)
+{
+	struct device_node *sysc;
+	void __iomem *base;
+	u32 soc_id = 0;
+
+	sysc = of_find_compatible_node(NULL, NULL, "realtek,rtl819x-sysc");
+	if (!sysc)
+		return 0;
+
+	base = of_iomap(sysc, 0);
+	if (base) {
+		soc_id = readl(base);
+		iounmap(base);
+	}
+	of_node_put(sysc);
+
+	return soc_id;
+}
+
+static int rtl8197f_dl_read(struct uart_8250_port *up)
+{
+	struct uart_port *p = &up->port;
+	unsigned int dll, dlm;
+
+	dll = readl(p->membase + (UART_DLL << p->regshift)) & 0xff;
+	dlm = readl(p->membase + (UART_DLM << p->regshift)) & 0xff;
+
+	return dll | (dlm << 8);
+}
+
+static void rtl8197f_dl_write(struct uart_8250_port *up, int value)
+{
+	struct uart_port *p = &up->port;
+
+	writel(value & 0xff,
+	       p->membase + (UART_DLL << p->regshift));
+	writel((value >> 8) & 0xff,
+	       p->membase + (UART_DLM << p->regshift));
+}
+
+static int rtl8197f_translate_lcr(struct dw8250_data *d, int value)
+{
+	if (d->adjlcr) {
+		unsigned int wlen = value & UART_LCR_WLEN8;
+
+		if (wlen == UART_LCR_WLEN7 || wlen == UART_LCR_WLEN8)
+			value = (value & ~UART_LCR_WLEN8) | (wlen - 2);
+	}
+	if (d->is_rtl8197f)
+		d->last_lcr = value;
+
+	return value;
+}
