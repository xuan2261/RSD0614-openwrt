/dts-v1/;

/*
 * Rock Space RSD0614 V1.0 — M3 dual-band Wi-Fi + LuCI + wired Gigabit RAM-boot.
 *
 * Hardware-verified target evidence (v5.3.9..v5.5.1 on silicon):
 *   - SoC: RTL8197FH-VG (SYSC_SOC_ID=0x81970001, BOND_OPTION=0x4 97FN, 40 MHz XTAL)
 *   - RAM: 64 MiB DDR2-533
 *   - Flash: BH25Q64 (0x684017), 8 MiB SPI NOR, 64 KiB erase blocks (6 read-only MTDs)
 *   - Serial: ttyS0, 115200 8N1 (vg-std 16550/DW-APB)
 *   - Physical Reset/WPS button: GPIO_PEFGH bit 4 (&gpio1 4 GPIO_ACTIVE_LOW)
 *   - External switch: RTL8367S (chip_num=0x6367, ver=0x0020) over bit-banged SMI
 *     SCK=&gpio1 24 (PH0), SDA=&gpio1 23 (PG7); EXT1/cpu_port=6, LAN=0..3, WAN=4
 *   - SoC<->switch RGMII trunk + VG 6-dword NIC: verified ping/SSH 0% loss in v5.5.1
 *   - PCIe0 (40 MHz XTAL): LTSSM=0x11 Link UP -> RTL8814BR (10ec:b814, 5 GHz wlan0)
 *   - On-SoC 2.4 GHz WMAC: RTL8197G (HAL_HW_TYPE_ID=0x15, cut=1, 2.4 GHz wlan1)
 *
 * RAM-boot safety policy:
 *   - every MTD partition remains strictly read-only;
 *   - persistent flash remains NO-GO;
 *   - pcie1 (unverified, shares IRQ 6 with WMAC) remains disabled;
 *   - unverified LED GPIOs remain unclaimed.
 */

#include "RTL8197F.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "rockspace,rsd0614", "realtek,rtl8197f-soc";
	model = "Rock Space RSD0614 V1.0";

	memory {
		device_type = "memory";
		reg = <0x00000000 0x04000000>; /* 64 MiB, target-verified */
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	gpio-keys-polled {
		compatible = "gpio-keys-polled";
		#address-cells = <1>;
		#size-cells = <0>;
		poll-interval = <20>;

		reset {
			label = "reset";
			gpios = <&gpio1 4 GPIO_ACTIVE_LOW>; /* PE4, verified in v5.4.1 */
			linux,code = <KEY_RESTART>;
		};
	};

	/*
	 * External RTL8367S 5-port Gigabit switch (chip_num=0x6367, ver=0x0020),
	 * verified in v5.4.2..v5.5.1 on bit-banged SMI SCK=PEFGH[24] (PH0), SDA=PEFGH[23] (PG7).
	 * RGMII uplink is EXT1 (port 6); LAN=ports 0..3 (VID2), WAN=port 4 (VID1).
	 * PH2 (gpio1 26, hardware RESET#) is held HIGH by bootloader and untouched.
	 */
	rtl8367b {
		compatible = "realtek,rtl8367b";
		cpu_port = <6>;
		realtek,extif1 = <1 0 1 1 1 1 1 1 2>;
		gpio-sck = <&gpio1 24 GPIO_ACTIVE_HIGH>;
		gpio-sda = <&gpio1 23 GPIO_ACTIVE_HIGH>;
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&serial0 {
	status = "okay";
};

&spi0 {
	status = "okay";

	m25p80@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>;
		/* Conservative single-lane clock; stock flash is BH25Q64. */
		spi-max-frequency = <25000000>;

		partition@0 {
			label = "bootloader";
			reg = <0x000000 0x020000>;
			read-only;
		};

		partition@20000 {
			label = "cfg";
			reg = <0x020000 0x010000>;
			read-only; /* per-unit RF/MAC/manufacturing data */
		};

		partition@30000 {
			label = "firmware";
			reg = <0x030000 0x7a0000>;
			read-only;
		};

		partition@7d0000 {
			label = "cpe";
			reg = <0x7d0000 0x010000>;
			read-only;
		};

		partition@7e0000 {
			label = "cfm";
			reg = <0x7e0000 0x010000>;
			read-only;
		};

		partition@7f0000 {
			label = "cfm_backup";
			reg = <0x7f0000 0x010000>;
			read-only;
		};
	};
};

&ethernet {
	status = "okay";
};

&pcie_clk {
	clock-frequency = <40000000>; /* 40 MHz XTAL, verified in v5.4.1/v5.4.2 */
};

&pcie0 {
	status = "okay"; /* 10ec:b814 RTL8814BR Link UP verified in v5.4.2..v5.5.1 */
};

&pcie1 {
	status = "disabled"; /* unverified silicon; shares cpuintc IRQ 6 with WMAC */
};

&wmac {
	compatible = "realtek,rtl8197g-wlan", "realtek,rtl8197f-wmac";
	reg = <0x18640000 0x40000>; /* RTL8197G 256 KiB WMAC aperture */
	status = "okay"; /* RTL8197G (HAL 0x15), target-verified in v5.4.2 */
};
