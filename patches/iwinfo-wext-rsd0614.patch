+static void wext_parse_rtl_rate(const char *val, struct iwinfo_rate_entry *re)
+{
+	int nss = 0, mcs = 0;
+	double mbps = 0.0;
+	const char *p = val;
+
+	while (*p == ' ' || *p == '\t')
+		p++;
+
+	if (!strncmp(p, "VHT NSS", 7))
+	{
+		char sgi = 0;
+		if (sscanf(p, "VHT NSS%d-MCS%d%c %lf", &nss, &mcs, &sgi, &mbps) >= 3)
+		{
+			re->is_vht = 1;
+			re->nss = (uint8_t)nss;
+			re->mcs = (int8_t)mcs;
+			if (sgi == 's')
+			{
+				re->is_short_gi = 1;
+			}
+			else
+			{
+				/* No 's' suffix: re-parse mbps directly after MCS%d */
+				sscanf(p, "VHT NSS%d-MCS%d %lf", &nss, &mcs, &mbps);
+			}
+			if (mbps > 0.0)
+				re->rate = (uint32_t)(mbps * 1000.0 + 0.5);
+		}
+	}
+	else if (!strncmp(p, "MCS", 3))
+	{
+		if (sscanf(p, "MCS%d %lf", &mcs, &mbps) >= 1)
+		{
+			re->is_ht = 1;
+			re->mcs = (int8_t)mcs;
+			if (mbps > 0.0)
+				re->rate = (uint32_t)(mbps * 1000.0 + 0.5);
+		}
+	}
+	else if (sscanf(p, "%lf", &mbps) == 1 && mbps > 0.0)
+	{
+		re->rate = (uint32_t)(mbps * 1000.0 + 0.5);
+	}
+}
+
+static void wext_parse_rtl_bw(const char *val, struct iwinfo_rate_entry *re)
+{
+	unsigned int bw = 0;
+
+	if (sscanf(val, "%u", &bw) == 1 && bw <= 160)
+	{
+		re->mhz = (uint8_t)bw;
+		re->is_40mhz = (bw == 40) ? 1 : 0;
+	}
+}
