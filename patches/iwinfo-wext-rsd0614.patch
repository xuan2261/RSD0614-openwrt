+static int wext_valid_ifname(const char *name)
+{
+	const char *p;
+
+	if (!name || !name[0] || strlen(name) >= IFNAMSIZ)
+		return 0;
+
+	for (p = name; *p; p++)
+	{
+		if (*p == '/' || (*p == '.' && p[1] == '.'))
+			return 0;
+	}
+
+	return 1;
+}
+
+const char *wext_resolve_ifname(const char *ifname, char *buf, size_t buflen)
+{
+	struct uci_section *s;
+	const char *phy;
+	char sysfs[64];
+
+	if (!ifname || !buf || buflen < IFNAMSIZ)
+		return ifname ? ifname : "";
+
+	if (!strncmp(ifname, "mon.", 4))
+		ifname += 4;
+
+	if (wext_valid_ifname(ifname))
+	{
+		snprintf(sysfs, sizeof(sysfs), "/sys/class/net/%s", ifname);
+		if (!access(sysfs, F_OK))
+		{
+			snprintf(buf, buflen, "%s", ifname);
+			return buf;
+		}
+	}
+
+	s = iwinfo_uci_get_radio(ifname, "rtl8192cd");
+	if (s)
+	{
+		phy = uci_lookup_option_string(uci_ctx, s, "phy");
+		if (phy && wext_valid_ifname(phy))
+		{
+			snprintf(buf, buflen, "%s", phy);
+			return buf;
+		}
+	}
+
+	if (!strncmp(ifname, "radio", 5) && isdigit((unsigned char)ifname[5]))
+	{
+		snprintf(buf, buflen, "wlan%s", ifname + 5);
+		return buf;
+	}
+
+	snprintf(buf, buflen, "%s", ifname);
+	return buf;
+}
