@@ -103,6 +106,24 @@ unsigned int rtl819x_bond_option(void)
 	if (!strcmp(profile, "mw5"))
 		return BSP_BOND_97FS;
 
+	if (!strcmp(profile, "rsd0614")) {
+		unsigned int strap = __raw_readl((void __iomem *)0xB800000CUL) & 0xfU;
+		switch (strap) {
+		case 0x0:
+			return BSP_BOND_97FB;
+		case 0x4:
+		case 0x5:
+		case 0x6:
+			return BSP_BOND_97FN;
+		case 0xa:
+		case 0xb:
+		case 0xc:
+			return BSP_BOND_97FS;
+		default:
+			return BSP_BOND_97FN;
+		}
+	}
