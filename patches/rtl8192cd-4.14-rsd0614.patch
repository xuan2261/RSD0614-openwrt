+	if (mtd->size < 0x10000) {
+		put_mtd_device(mtd);
+		return 0;
+	}
+	buf = kmalloc(0x10000, GFP_KERNEL);
+	if (!buf) {
+		put_mtd_device(mtd);
+		return -ENOMEM;
+	}
+	ret = mtd_read(mtd, 0, 0x10000, &retlen, buf);
+	put_mtd_device(mtd);
+	if (ret || retlen != 0x10000) {
+		kfree(buf);
+		dev_warn(dev, "read-only cfg MTD read incomplete (%d, %zu); keeping eFuse defaults\n",
+			 ret, retlen);
+		return 0;
+	}
+	ret = devm_add_action_or_reset(dev, rtl8192cd_linux6_kfree, buf);
+	if (ret)
+		return ret;
+	*data = buf;
+	*data_len = 0x10000;
+	return 0;
