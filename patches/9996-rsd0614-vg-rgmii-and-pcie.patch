From: Rock Space RSD0614 V1.0 OpenWrt RAM-Boot Port
Subject: [PATCH] realtek: RTL8197FH-VG 6-dword new-descriptor NIC, RGMII trunk, and 40 MHz PCIe0

1. drivers/net/ethernet/rtl819x/{rtl819x_regs.h,rtl819x_swnic.h,rtl819x_swnic.c,rtl819x-eth.c}:
   - Native 6-dword (24-byte) single-level new-descriptor RX/TX engine for
     RTL8197FH-VG (soc_id 0x81970001), matching bootloader/SDK v3.6.0 CPUICR1
     (0x001861d3: CF_RXDESC=6, CF_TXDESC=6, TX_PKTHDR_SHORTCUT_LSO),
     DMA_CR1=(txCnt-1)*24, DMA_CR4=TX_RING0_TAIL_AWARE, TXRINGCR=TX_RING0_EN,
     CPUQDM0/2/4=0, and MACCTRL1|=CF_CMAC_CLK_SEL.
   - Clean dual-mode selector (`desc_mode`: -1=auto 1 on VG / 0 on non-VG,
     writable at runtime via /sys/module/rtl819x/parameters/desc_mode) with
     legacy 2-level CPUICR1=0x00000082 fallback and safe ring-switch cleanup.
   - Re-verify CPUICR1/DMA ring geometry after SIRR=TRXRDY (VG stopped-state
     write-discard erratum), guard against persistent PKTHDR/MBUF_DESC_RUNOUT
     ISR storms when rx_done==0, rate-limit ISR traces, and preserve VG RGMII
     pad mux (0x579fff7f) + PITCR CF_FIX_IPG + RX delay 7.
2. arch/mips/pci/pci-realtek.c:
   - Program RTL8197FH-VG 40 MHz XTAL PCIe0 PHY PLL MDIO reg 0x08=0x3101 on
     soc_id 0x81970000..0x81970fff (hardware-verified PCIe0 Link UP to 10ec:b814).

---
diff --git a/arch/mips/pci/pci-realtek.c b/arch/mips/pci/pci-realtek.c
index 3326987..9aefeb6 100644
--- a/arch/mips/pci/pci-realtek.c
+++ b/arch/mips/pci/pci-realtek.c
@@ -294,6 +294,8 @@ static void realtek_pcie_reset(struct realtek_pci_controller *rpc)
 		realtek_pcie_mdio_write(rpc, 0x0f, 0x12f6);
 		realtek_pcie_mdio_write(rpc, 0x00, 0x0071);
 		realtek_pcie_mdio_write(rpc, 0x06, 0x1ac1);
+		if ((sr_r32(REALTEK_SR_REG_ID) & 0xFFFFF000u) == 0x81970000u)
+			realtek_pcie_mdio_write(rpc, 0x08, 0x3101);
 	} else {
 		realtek_pcie_mdio_write(rpc, 0x00, 0x0071);
 		realtek_pcie_mdio_write(rpc, 0x06, 0x18c1);
diff --git a/drivers/net/ethernet/rtl819x/rtl819x-eth.c b/drivers/net/ethernet/rtl819x/rtl819x-eth.c
index 1035361..659d4ed 100644
--- a/drivers/net/ethernet/rtl819x/rtl819x-eth.c
+++ b/drivers/net/ethernet/rtl819x/rtl819x-eth.c
@@ -440,6 +440,14 @@ static int trunk_pause = 2;
 module_param(trunk_pause, int, 0644);
 MODULE_PARM_DESC(trunk_pause, "RGMII-trunk 802.3x pause: 2=force OFF (default, A-2 residual fix), 1=force on (bench A/B collapse), 0=leave loader value");
 
+static int p0_rx_delay = -1;
+module_param(p0_rx_delay, int, 0644);
+MODULE_PARM_DESC(p0_rx_delay, "Port0 RGMII RX delay (0..7; -1=auto: 7 on RTL8197F-VG, 5 on non-VG)");
+
+static int p0_tx_delay = -1;
+module_param(p0_tx_delay, int, 0644);
+MODULE_PARM_DESC(p0_tx_delay, "Port0 RGMII TX delay (0..1; -1=auto: 1)");
+
 /* 8367S half of the trunk-pause fix (rtl8367b.c; CONFIG_RTL8367B_PHY=y, so
  * this built-in <-> built-in reference links into vmlinux). */
 extern int rtl8367s_trunk_pause_set(int on);
@@ -478,7 +486,8 @@ static void rtl865x_start(void)
 	 * fabric snapshot at the end of this function so a fabric_reset
 	 * restores the corrected value rather than the loader's.
 	 */
-	REG32(CPUICR1) |= (1u << 1);
+	/* Configure CPUICR1, ring geometry, and byte order for active desc mode. */
+	New_swNic_program_regs(false);
 
 	/* Enable Tx/Rx, 128-word Lexra bus burst, 2048-byte mbufs. */
 	REG32(CPUICR) = TXCMD | RXCMD | BUSBURST_128WORDS | MBUF_2048BYTES;
@@ -544,8 +553,13 @@ static void rtl865x_start(void)
 			REG32(PBFCR0 + q * 0x04) = (0x003Cu << 16) | 0x005Au;
 	}
 
-	/* Kick the switch core into normal Tx/Rx. */
+	/* Kick the switch core into normal Tx/Rx, then re-verify CPUICR1/DMA
+	 * geometry (RTL8197F-VG can discard descriptor-format writes made while
+	 * CPUICR is stopped) and ensure CMAC clock select is active. */
 	REG32(SIRR) = TRXRDY;
+	New_swNic_program_regs(true);
+	REG32(RTL819X_SWCORE_BASE + 0x4000) |= (1u << 12);
+	REG32(MACCTRL1) |= CF_CMAC_CLK_SEL;
 
 	/*
 	 * M6.6 KNOWN-OPEN (A-2): sustained max-rate ROUTED bulk (~700 Mbit/s iperf3
@@ -680,35 +694,42 @@ static void rtl865x_start(void)
 		 * in exactly this test, which is why every step below is loader-exact. */
 		{
 			u32 v;
-
-			/* 1. board RGMII pad mux/drive (loader value) */
-			REG32(0xB8000850) =
-				(REG32(0xB8000850) & 0x019FFFFF) | 0xDA600000;
+			bool is_vg = ((REG32(0xB8000000) & 0xFFFFF000u) == 0x81970000u);
+			u32 rx_delay = (p0_rx_delay >= 0) ? ((u32)p0_rx_delay & 7u) : (is_vg ? 7u : 5u);
+			u32 tx_delay = (p0_tx_delay >= 0) ? ((u32)p0_tx_delay & 1u) : 1u;
+
+			/* 1. board RGMII pad mux/drive:
+			 *    RTL8197FH-VG (0x81970000): preserve bootloader VG pad config
+			 *    (RSD0614 V1.0 bootloader 0x579fff7f; non-VG 0xDA600000 clobbers
+			 *    bits[31:21], clearing VG bits 26/24/23 and setting bit 31). */
+			if (is_vg) {
+				if (!(REG32(0xB8000850) & (1u << 25)))
+					REG32(0xB8000850) = 0x579fff7fu;
+			} else {
+				REG32(0xB8000850) =
+					(REG32(0xB8000850) & 0x019FFFFF) | 0xDA600000;
+			}
 			/* 2. MACCR CF_SYSCLK_SEL (bits[13:12]=01) + MACCR1 bit0 */
 			REG32(RTL819X_SWCORE_BASE + 0x4000) |= (1u << 12);
 			REG32(RTL819X_SWCORE_BASE + 0x4058) |= (1u << 0);
-			/* 3. EXTPCR0 bits[19:16] = 0x8 (stock init_8367r) */
+			/* 3. EXTPCR0 bits[19:16] = 0x8 (8-byte TX IPG for CPU-tag mode);
+			 *    RTL8197F-VG also sets PITCR CF_FIX_IPG (bits[17:12]=1). */
 			v = REG32(RTL819X_SWCORE_BASE + 0x5108);
 			REG32(RTL819X_SWCORE_BASE + 0x5108) =
 				(v & ~(0xFu << 16)) | (0x8u << 16);
+			if (is_vg) {
+				v = REG32(RTL819X_SWCORE_BASE + 0x4100);
+				REG32(RTL819X_SWCORE_BASE + 0x4100) =
+					(v & ~(0x3Fu << 12)) | (1u << 12);
+			}
 			/* 4. P0GMIICR: GMAC=RGMII (bits[24:23]=0), loader fields
-			 * bits[17:16]=3 + bits[15:8]=0x7d, delays TX(bit4)+RX=5.
+			 * bits[17:16]=3 + bits[15:8]=0x7d, delays TX+RX (VG=7, non-VG=5).
 			 * Conf_done (bit6) stays CLEAR here — latched LAST, after
-			 * the settle, exactly like the loader.
-			 *
-			 * CPU-tag mode: the vendor's 8197F+8367R arrangement, copied
-			 * from init_8197f_p0() (sdk rtl865x_asicL2.c:6408):
-			 *   P0GMIICR |= (3 << CF_SEL_RGTXC_OFFSET);
-			 *   P0GMIICR |= (CFG_CPUC_TAG | CFG_TX_CPUC_TAG);  bits 25,26
-			 *   MACCR1   |= PORT0_ROUTER_MODE;                 bit0 (step 2)
-			 * The SoC MAC then inserts/strips the 4-byte 0x8899 tag in
-			 * HARDWARE, so the RX descriptor's spa carries the real jack
-			 * and TX can name a destination port. Conf_done still latches
-			 * last, below — that ordering is what the loader relies on. */
+			 * the settle, exactly like the loader. */
 			v = REG32(RTL819X_SWCORE_BASE + 0x414C);
 			v &= ~((3u << 25) | (3u << 23) | (3u << 18) |
 			       (3u << 16) | (0xFFu << 8) | 0xFFu);
-			v |= (3u << 16) | (0x7Du << 8) | (1u << 4) | (5u << 0);
+			v |= (3u << 16) | (0x7Du << 8) | (tx_delay << 4) | (rx_delay << 0);
 			v |= (3u << 25) | (3u << 18);	/* CFG_CPUC_TAG|CFG_TX_CPUC_TAG, CF_SEL_RGTXC */
 			REG32(RTL819X_SWCORE_BASE + 0x414C) = v;
 			/* 5. PITCR port0 = RGMII (default UTP!) */
@@ -786,11 +807,13 @@ static void rtl865x_start(void)
 			if (rtl8367s_trunk_pause_set(trunk_pause == 1) < 0)
 				pr_err("rtl819x trunk-pause: 8367S SMI not probed — SoC side only (re-apply: eth0 down/up)\n");
 		}
-		pr_err("rtl819x trunk-post: PITCR=%08x P0GMIICR=%08x MACCR=%08x PCRP0=%08x\n",
+		pr_err("rtl819x trunk-post: PITCR=%08x P0GMIICR=%08x MACCR=%08x PCRP0=%08x EXTPCR0=%08x PAD=%08x\n",
 		       REG32(RTL819X_SWCORE_BASE + 0x4100),
 		       REG32(RTL819X_SWCORE_BASE + 0x414C),
 		       REG32(RTL819X_SWCORE_BASE + 0x4000),
-		       REG32(RTL819X_SWCORE_BASE + 0x4104));
+		       REG32(RTL819X_SWCORE_BASE + 0x4104),
+		       REG32(RTL819X_SWCORE_BASE + 0x5108),
+		       REG32(0xB8000850));
 
 		REG32(MSCR) |= MSCR_EN_L2;		/* global L2 forwarding enable (LAST) */
 	}
@@ -798,9 +821,11 @@ static void rtl865x_start(void)
 	/* Bring-up self-diagnosis (readable over ssh via `dmesg`): on a dead-RX
 	 * boot the ring base still latches into CPURPDCR0 but CPUIISR never accrues
 	 * RX_DONE — that distinguishes an engine wedge from a fabric-silent path. */
-	pr_err("rtl819x bringup: CPUICR=%08x CPURPDCR0=%08x CPUIISR=%08x DMA_CR0=%08x MSCR=%08x GDSR0=%08x SBFCR0=%08x CPUICR1=%08x\n",
-	       REG32(CPUICR), REG32(CPURPDCR0), REG32(CPUIISR), REG32(DMA_CR0), REG32(MSCR),
-	       REG32(GDSR0), REG32(SBFCR0), REG32(CPUICR1));
+	pr_err("rtl819x bringup: CPUICR=%08x CPURPDCR0=%08x CPUTPDCR0=%08x CPUIISR=%08x DMA_CR0=%08x DMA_CR1=%08x DMA_CR4=%08x TXRINGCR=%08x CPUQDM0=%08x MACCTRL1=%08x MSCR=%08x GDSR0=%08x SBFCR0=%08x CPUICR1=%08x newdesc=%d\n",
+	       REG32(CPUICR), REG32(CPURPDCR0), REG32(CPUTPDCR0), REG32(CPUIISR),
+	       REG32(DMA_CR0), REG32(DMA_CR1), REG32(DMA_CR4), REG32(TXRINGCR),
+	       REG32(CPUQDM0), REG32(MACCTRL1), REG32(MSCR), REG32(GDSR0),
+	       REG32(SBFCR0), REG32(CPUICR1), rtl819x_use_new_desc() ? 1 : 0);
 
 	/* M7: latch the known-good fabric config ONCE, at the end of the first
 	 * successful bring-up (loader groundwork + this function's programming,
@@ -826,7 +851,7 @@ static irqreturn_t rtl819x_eth_isr(int irq, void *dev_id)
 	u32 status;
 
 	status = readl(priv->base + R_CPUIISR);
-	{ static u32 isr_n; if (!(isr_n++ & 0x7ff)) pr_info("rtl819x isr#%u st=%08x\n", isr_n, status); }
+	{ static u32 isr_n; if (!(isr_n++ & 0x7ff)) pr_info_ratelimited("rtl819x isr#%u st=%08x\n", isr_n, status); }
 
 	/*
 	 * Mask at BOTH the CPU-iface (CPUIIMR) AND the global controller
@@ -1273,7 +1298,10 @@ static int rtl819x_eth_poll(struct napi_struct *napi, int budget)
 				skb = skb_vlan_untag(skb);	/* -> hwaccel tag = real vid */
 				if (!skb) { dev->stats.rx_dropped++; continue; }
 			} else {
-				__vlan_hwaccel_put_tag(skb, htons(ETH_P_8021Q), 2);
+				u16 vid = (info.vid == RTL865X_VID_WAN || info.vid == RTL865X_VID_LAN)
+					  ? info.vid
+					  : ((info.pid == GW_JACK_WAN) ? RTL865X_VID_WAN : RTL865X_VID_LAN);
+				__vlan_hwaccel_put_tag(skb, htons(ETH_P_8021Q), vid);
 			}
 		}
 		napi_gro_receive(napi, skb);
@@ -1284,11 +1312,17 @@ static int rtl819x_eth_poll(struct napi_struct *napi, int budget)
 	}
 
 	/* M6.3: NAPI complete -> re-arm the switch NIC IRQ the ISR masked (CPUIIMR
-	 * + CP0 IP4). */
+	 * + CP0 IP4). Guard against persistent RUNOUT level-IRQ storms when no
+	 * frames were drained (rely on the 10ms watchdog until RX recovers). */
 	if (rx_done < budget) {
+		u32 iimr = NIC_IIMR;
+
 		napi_complete_done(napi, rx_done);
 		REG32(CPUIISR) = REG32(CPUIISR);
-		REG32(CPUIIMR) = NIC_IIMR;
+		if (rx_done == 0 &&
+		    (REG32(CPUIISR) & (PKTHDR_DESC_RUNOUT_IP_ALL | MBUF_DESC_RUNOUT_IP_ALL)))
+			iimr &= ~(PKTHDR_DESC_RUNOUT_IE_ALL | MBUF_DESC_RUNOUT_IE_ALL);
+		REG32(CPUIIMR) = iimr;
 		REG32(GIMR) |= BSP_SW_IE;
 		set_c0_status(STATUSF_IP4);
 		/*
@@ -1364,19 +1398,6 @@ static netdev_tx_t rtl819x_eth_xmit(struct sk_buff *skb, struct net_device *dev)
 
 	memset(&nicTx, 0, sizeof(nicTx));
 	nicTx.txIdx = 0;
-	/*
-	 * v18: direct-port flood instead of HWLOOKUP. v17 proved the box RXes hal's
-	 * ARPs and sends replies, but HWLOOKUP UNICAST replies get dropped in the
-	 * switch and never reach hal's wire (while HWLOOKUP broadcast DID reach
-	 * hal). So egress every CPU frame directly to the physical ports 0-5
-	 * (tx_dp=0x3F) in VLAN 9 — this includes the RTL8367R uplink port, mirrors
-	 * the broadcast path that reached hal, and EXCLUDES the CPU port (bit6) so
-	 * the frame can't loop back to us. VLAN 9 egress is untagged (see
-	 * rtl865x_start) so the RTL8367R gets clean frames.
-	 * (M6.5 note: narrowing this is INEFFECTIVE - the switch floods CPU frames
-	 * by VLAN *membership*, ignoring this portlist; see auto-memory.)
-	 */
-	nicTx.portlist = 0x3F;
 	/*
 	 * VID from the netdev's hwaccel VLAN tag — eth0.2 (LAN) -> VID 2,
 	 * eth0.1 (WAN) -> VID 1 (the M6.6 Fork A VLAN plan); an untagged frame
@@ -1395,6 +1416,11 @@ static netdev_tx_t rtl819x_eth_xmit(struct sk_buff *skb, struct net_device *dev)
 		nicTx.vid = skb_vlan_tag_get(skb) & 0xfff;
 	else
 		nicTx.vid = 2;
+	/* In new-descriptor CPU-tag mode, target the VLAN's jack portmask
+	 * (WAN jack 4 = 0x10, LAN jacks 0-3 = 0x0F); legacy mode keeps 0x3F. */
+	nicTx.portlist = rtl819x_use_new_desc()
+		? ((nicTx.vid == RTL865X_VID_WAN) ? (1u << GW_JACK_WAN) : GW_JACK_LAN_MASK)
+		: 0x3F;
 	nicTx.flags = 0;	/* direct-TX: swnic adds PKTHDR_USED_8197F|PKT_OUTGOING */
 
 	if (New_swNic_send(skb, (void *)(uintptr_t)dma, len, &nicTx) != 0) {
@@ -1554,6 +1580,9 @@ static int rtl819x_eth_probe(struct platform_device *pdev)
 	else
 		eth_hw_addr_random(dev);
 
+	if (of_machine_is_compatible("rockspace,rsd0614"))
+		fabric_gw_rearm = 0;
+
 	New_swNic_setDev(dev);
 	platform_set_drvdata(pdev, dev);
 
diff --git a/drivers/net/ethernet/rtl819x/rtl819x_regs.h b/drivers/net/ethernet/rtl819x/rtl819x_regs.h
index 3e7f6b4..3215b66 100644
--- a/drivers/net/ethernet/rtl819x/rtl819x_regs.h
+++ b/drivers/net/ethernet/rtl819x/rtl819x_regs.h
@@ -49,6 +49,9 @@
 #define CPUTPDCR1			(0x024 + CPU_IFACE_BASE)	/* Tx pkthdr desc ctrl 1 */
 #define CPUIIMR				(0x028 + CPU_IFACE_BASE)	/* interrupt mask */
 #define CPUIISR				(0x02c + CPU_IFACE_BASE)	/* interrupt status */
+#define CPUQDM0				(0x030 + CPU_IFACE_BASE)	/* Rx queue->ring map 0/1 */
+#define CPUQDM2				(0x034 + CPU_IFACE_BASE)	/* Rx queue->ring map 2/3 */
+#define CPUQDM4				(0x038 + CPU_IFACE_BASE)	/* Rx queue->ring map 4/5 */
 #define DMA_CR0				(0x03c + CPU_IFACE_BASE)
 #define DMA_CR1				(0x040 + CPU_IFACE_BASE)
 #define DMA_CR2				(0x044 + CPU_IFACE_BASE)
@@ -98,13 +101,22 @@
 #define TX_ALL_DONE_IP_ALL		(TX_ALL_DONE_IP0 | TX_ALL_DONE_IP1 | \
 					 TX_ALL_DONE_IP2 | TX_ALL_DONE_IP3)
 
-/* ---- DMA_CR0 / DMA_CR4 / CPUICR1 ---------------------------------------- */
+/* ---- DMA_CR0 / DMA_CR4 / TXRINGCR / CPUICR1 / MACCTRL1 ------------------- */
 #define LowFifoMark_OFFSET		8
 #define LowFifoMark_MASK		(0xff << 8)
 #define HiFifoMark_MASK			(0xff << 0)
 #define TX_RING0_TAIL_AWARE		(1 << 0)
+#define TX_RING0_EN			(1 << 0)
 #define CF_PKT_HDR_TYPE_OFFSET		8
 #define CF_PKT_HDR_TYPE_MASK		(3 << 8)
+#define TX_PKTHDR_8198C_DEF		(0 << 8)
+#define TX_PKTHDR_SHORTCUT_LSO		(1 << 8)
+#define CF_TXDESC_OFFSET		12
+#define CF_TXDESC_MASK			(0x3f << 12)
+#define CF_RXDESC_OFFSET		18
+#define CF_RXDESC_MASK			(0x3f << 18)
+#define MACCTRL1			(RTL819X_SWCORE_BASE + 0x5100)
+#define CF_CMAC_CLK_SEL			(1 << 0)
 
 /* ---- global interrupt controller (GICR) --------------------------------- */
 #define GIMR				(0x000 + GICR_BASE)	/* global interrupt mask */
diff --git a/drivers/net/ethernet/rtl819x/rtl819x_swnic.c b/drivers/net/ethernet/rtl819x/rtl819x_swnic.c
index 2e2718e..94589d8 100644
--- a/drivers/net/ethernet/rtl819x/rtl819x_swnic.c
+++ b/drivers/net/ethernet/rtl819x/rtl819x_swnic.c
@@ -75,6 +75,38 @@ static int pid_dump;
 module_param(pid_dump, int, 0644);
 MODULE_PARM_DESC(pid_dump, "log source port/vid/asic0 for the next N RX frames (CPU-tag bring-up instrument)");
 
+/* Descriptor format selector: -1=auto (1=new 6-dword on RTL8197F-VG, 0=legacy 2-level on non-VG). */
+static int desc_mode = -1;
+module_param(desc_mode, int, 0644);
+MODULE_PARM_DESC(desc_mode, "NIC descriptor mode: -1=auto (1 on RTL8197F-VG, 0 on non-VG), 1=new 6-dword, 0=legacy 2-level");
+
+static int new_tx_vlantag = 0x3f;
+module_param(new_tx_vlantag, int, 0644);
+MODULE_PARM_DESC(new_tx_vlantag, "New-descriptor TX vlantag egress port mask for untagged skbs (default 0x3f)");
+
+static int new_tx_extspa;
+module_param(new_tx_extspa, int, 0644);
+MODULE_PARM_DESC(new_tx_extspa, "New-descriptor direct-TX extspa field (0=default per SDK, 3=CPU)");
+
+/* RTL8197F-VG single-level 6-dword (24-byte) new descriptors (LE MIPS32). */
+struct rtl_new_rx_desc {
+	u32 opts1;	/* [0]=own [1]=eor [2]=ls [3]=fs [31:16]=m_extsize */
+	u32 mdata;	/* physical DMA address of cluster buffer */
+	u32 opts2;	/* [13:0]=len [19:17]=qid [23:20]=dp_ext [25:24]=extspa */
+	u32 opts3;	/* [15:0]=reason [22:16]=linkid */
+	u32 opts4;	/* [15:13]=spa [27:16]=dvlanid [28]=l2act */
+	u32 opts5;	/* [11:0]=svlanid [28]=org [29]=fwd [30]=l4csok [31]=l3csok */
+};
+
+struct rtl_new_tx_desc {
+	u32 opts1;	/* [0]=own [1]=eor [2]=ls [3]=fs [4]=hwlkup [5]=bridge [22:6]=ph_len [28]=vi */
+	u32 mdata;	/* physical DMA address of packet data */
+	u32 opts2;	/* [8:0]=vlantag [11:9]=pqid [14:12]=qid [31:15]=mlen */
+	u32 opts3;	/* [11:0]=dvlanid [14:12]=dp_ext [24:22]=dpri */
+	u32 opts4;	/* [15:0]=ipv6_hdrlen [22:16]=linkid [30:24]=dp [31]=lso */
+	u32 opts5;	/* [3:0]=tcp_hlen [7:4]=ipv4_hlen [15:8]=flags [29:16]=mss [31:30]=extspa */
+};
+
 /*
  * M7 FCS wedge signal: every large (>132 B) delivered frame gets its Ethernet
  * FCS software-verified (EXCLUDE_CRC is clear, so ph_len includes the 4 FCS
@@ -148,8 +180,10 @@ static void coh_free(struct coh *c)
 }
 
 /* ---- ring 0 state (the eth driver only uses ring 0) --------------------- */
-static struct coh rxPh, rxMb, rxRing, rxMring;	/* pkthdr pool, mbuf pool, two rings */
+static struct coh rxPh, rxMb, rxRing, rxMring;	/* legacy 2-level rings */
 static struct coh txPh, txMb, txRing;
+static struct coh newRxRing, newTxRing;		/* new 6-dword single-level rings */
+static bool new_desc_active;
 static uint32 rxCnt, txCnt;
 static uint32 rxCurr;			/* next rx pkthdr the CPU will inspect */
 static uint32 txCurr, txDoneIdx;	/* tx produce / reclaim indices */
@@ -168,12 +202,73 @@ static inline struct rtl_mBuf *TXMB(uint32 i)
 static inline volatile uint32 *RXR(void) { return (volatile uint32 *)COH_V(rxRing); }
