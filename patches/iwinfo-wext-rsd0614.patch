+static int wext_parse_rtl_sta_info_file(FILE *f, char *buf, int *len)
+{
+	char line[256];
+	struct iwinfo_assoclist_entry cur;
+	int have_cur = 0;
+	int have_mac = 0;
+	int outlen = 0;
+
+	memset(&cur, 0, sizeof(cur));
+
+	while (fgets(line, sizeof(line), f))
+	{
+		char *p = line;
+		unsigned int uval = 0;
+
+		while (*p == ' ' || *p == '\t')
+			p++;
+
+		if (strstr(p, ": stat_info..."))
+		{
+			if (have_cur && have_mac &&
+			    (outlen + (int)sizeof(cur)) <= IWINFO_BUFSIZE)
+			{
+				memcpy(buf + outlen, &cur, sizeof(cur));
+				outlen += (int)sizeof(cur);
+			}
+			memset(&cur, 0, sizeof(cur));
+			cur.noise = -95;
+			cur.rx_rate.mcs = -1;
+			cur.tx_rate.mcs = -1;
+			cur.is_authenticated = 1;
+			cur.is_authorized = 1;
+			have_cur = 1;
+			have_mac = 0;
+			continue;
+		}
+
+		if (!have_cur)
+			continue;
+
+		if (!strncmp(p, "hwaddr:", 7))
+		{
+			unsigned int m[6];
+			const char *q = p + 7;
+			while (*q == ' ' || *q == '\t')
+				q++;
+			if (sscanf(q, "%02x:%02x:%02x:%02x:%02x:%02x",
+			           &m[0], &m[1], &m[2], &m[3], &m[4], &m[5]) == 6 ||
+			    sscanf(q, "%02x%02x%02x%02x%02x%02x",
+			           &m[0], &m[1], &m[2], &m[3], &m[4], &m[5]) == 6)
+			{
+				int i;
+				for (i = 0; i < 6; i++)
+					cur.mac[i] = (uint8_t)m[i];
+				have_mac = 1;
+			}
+		}
+		else if (!strncmp(p, "rssi:", 5))
+		{
+			if (sscanf(p + 5, "%u", &uval) == 1)
+			{
+				if (uval > 100)
+					uval = 100;
+				cur.signal = (int8_t)((int)uval - 100);
+				cur.signal_avg = cur.signal;
+			}
+		}
+		else if (!strncmp(p, "tx_bytes:", 9))
+		{
+			if (sscanf(p + 9, "%u", &uval) == 1)
+				cur.tx_bytes = uval;
+		}
+		else if (!strncmp(p, "rx_bytes:", 9))
+		{
+			if (sscanf(p + 9, "%u", &uval) == 1)
+				cur.rx_bytes = uval;
+		}
+		else if (!strncmp(p, "tx_pkts:", 8))
+		{
+			if (sscanf(p + 8, "%u", &uval) == 1)
+				cur.tx_packets = uval;
+		}
+		else if (!strncmp(p, "rx_pkts:", 8))
+		{
+			if (sscanf(p + 8, "%u", &uval) == 1)
+				cur.rx_packets = uval;
+		}
+		else if (!strncmp(p, "tx_fail:", 8))
+		{
+			if (sscanf(p + 8, "%u", &uval) == 1)
+				cur.tx_failed = uval;
+		}
+		else if (!strncmp(p, "idle_time:", 10))
+		{
+			if (sscanf(p + 10, "%u", &uval) == 1)
+				cur.inactive = uval * 1000;
+		}
+		else if (!strncmp(p, "link_time:", 10))
+		{
+			if (sscanf(p + 10, "%u", &uval) == 1)
+				cur.connected_time = uval;
+		}
+		else if (!strncmp(p, "current_tx_rate:", 16))
+		{
+			wext_parse_rtl_rate(p + 16, &cur.tx_rate);
+		}
+		else if (!strncmp(p, "current_rx_rate:", 16))
+		{
+			wext_parse_rtl_rate(p + 16, &cur.rx_rate);
+		}
+		else if (!strncmp(p, "rx_rate:", 8))
+		{
+			wext_parse_rtl_rate(p + 8, &cur.rx_rate);
+		}
+		else if (!strncmp(p, "current_tx_BW:", 14))
+		{
+			wext_parse_rtl_bw(p + 14, &cur.tx_rate);
+		}
+		else if (!strncmp(p, "tx_bw:", 6) && !cur.tx_rate.mhz)
+		{
+			wext_parse_rtl_bw(p + 6, &cur.tx_rate);
+		}
+		else if (!strncmp(p, "rx_bw:", 6))
+		{
+			wext_parse_rtl_bw(p + 6, &cur.rx_rate);
+		}
+	}
+
+	if (have_cur && have_mac &&
+	    (outlen + (int)sizeof(cur)) <= IWINFO_BUFSIZE)
+	{
+		memcpy(buf + outlen, &cur, sizeof(cur));
+		outlen += (int)sizeof(cur);
+	}
+
+	*len = outlen;
+	return 0;
+}
